#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

&trackpad_listener_L {
    status = "okay"; /* 最初はdisabledになっているので、ここで有効化します */

    /* 通常時の速度調整：好みに合わせて数値を変更してください */
    input-processors = <&trackpad_key_behaviors_L>,
                      <&zip_xy_scaler 1 5>,        /* 5倍速（等速） */
                      <&zip_scroll_scaler 1 12>,
                      <&zip_dynamic_xy_scaler>,
                      <&zip_dynamic_scroll_scaler>,
                      <&pointer_accel>;

    /* レイヤー1または2（精細・低速モード）に入ったときの速度調整 */
    lowspeedmode {
        layers = <1 2>;
        input-processors = <&trackpad_key_behaviors_L>,
                          <&zip_xy_scaler 1 15>,       /* 15分の1（超低速） */
                          <&zip_scroll_scaler 1 40>,
                          <&zip_dynamic_xy_scaler>,
                          <&zip_dynamic_scroll_scaler>;
    };
};

&trackpad_listener_R {
    status = "okay"; /* 右側も有効化 */

    input-processors = <&trackpad_key_behaviors_R>,
                      <&zip_xy_scaler 1 5>,
                      <&zip_scroll_scaler 1 12>,
                      <&zip_dynamic_xy_scaler>,
                      <&zip_dynamic_scroll_scaler>,
                      <&pointer_accel>;

    lowspeedmode {
        layers = <1 2>;
        input-processors = <&trackpad_key_behaviors_R>,
                          <&zip_xy_scaler 1 15>,
                          <&zip_scroll_scaler 1 40>,
                          <&zip_dynamic_xy_scaler>,
                          <&zip_dynamic_scroll_scaler>;
    };
};

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&mo 1>;
        };

        tap_preferred: tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };

        hold_prefferd: hold_prefferd {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_PREFFERD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
        };

        layer_hold_priority: layer_hold_priority {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD_PRIORITY";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
            hold-while-undecided;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        en {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <12 11>;
        };

        jp {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <17 18>;
        };

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <27 28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&tap_preferred ESCAPE Q                  &kp W                      &kp E                       &kp R                         &kp T                              &kp Y                            &kp U                         &kp I                       &kp O                      &tap_preferred EQUAL P
&tap_preferred LCTRL A                   &tap_preferred LEFT_GUI S  &tap_preferred RIGHT_ALT D  &tap_preferred LEFT_SHIFT F   &kp G                              &kp H                            &tap_preferred LEFT_SHIFT J   &tap_preferred RIGHT_ALT K  &tap_preferred LEFT_GUI L  &tap_preferred LEFT_CONTROL MINUS
&tap_preferred LA(LC(LG(LEFT_SHIFT))) Z  &kp X                      &kp C                       &kp V                         &kp B                              &kp N                            &kp M                         &kp COMMA                   &kp PERIOD                 &kp SLASH
&sk LEFT_GUI                             &none                      &none                       &layer_hold_priority 1 LANG2  &kp SPACE     &mkp MB1  &kp ENTER  &tap_preferred LEFT_SHIFT ENTER  &layer_hold_priority 2 LANG1  &none                       &mo 4                      &sk LEFT_SHIFT
                                         &none                      &kp LC(RIGHT)               &kp DOWN                      &kp LC(LEFT)  &kp UP    &kp UP     &kp LC(LEFT)                     &kp DOWN                      &kp LC(RIGHT)               &none
&mkp LCLK                                &mkp RCLK                  &mkp MCLK                                                                                                                                                   &mkp LCLK                   &mkp RCLK                  &mkp MCLK
&mkp MB4                                 &mkp MB5                   &kp LG(TAB)                 &kp LG(D)                     &kp LCTRL                          &mkp MB4                         &mkp MB5                      &kp LG(TAB)                 &kp LG(D)                  &kp LCTRL
            >;
        };

        marks {
            display-name = "marks";
            bindings = <
&kp EXCLAMATION                  &kp AT_SIGN   &kp HASH       &kp DOLLAR                  &kp PERCENT                                 &kp CARET      &kp AMPERSAND                 &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&tap_preferred LEFT_CONTROL TAB  &sk LEFT_GUI  &sk RIGHT_ALT  &sk LEFT_SHIFT              &sk LA(LC(LG(LEFT_SHIFT)))                  &kp LEFT       &kp DOWN                      &kp UP_ARROW      &kp RIGHT             &tap_preferred LEFT_CONTROL SEMICOLON
&kp ESCAPE                       &kp GRAVE     &kp TILDE      &sk LA(LC(LG(LEFT_SHIFT)))  &kp LS(LG(NUMBER_4))                        &kp EQUAL      &kp SINGLE_QUOTE              &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp BACKSLASH
&trans                           &trans        &trans         &trans                      &trans                      &trans  &trans  &kp BACKSPACE  &layer_hold_priority 3 ENTER  &trans            &trans                &kp DELETE
                                 &trans        &trans         &trans                      &trans                      &trans  &trans  &trans         &trans                        &trans            &trans
&trans                           &trans        &trans                                                                                                                              &trans            &trans                &trans
&trans                           &trans        &trans         &trans                      &trans                                      &trans         &trans                        &trans            &trans                &trans
            >;
        };

        numbers {
            display-name = "numbers";
            bindings = <
&kp NUMBER_1                     &kp NUMBER_2       &kp NUMBER_3   &kp NUMBER_4                &kp N5                                      &kp NUMBER_6      &kp N7             &kp N8        &kp N9        &kp RS(N0)
&tap_preferred LEFT_CONTROL TAB  &sk LEFT_GUI       &sk RIGHT_ALT  &sk LEFT_SHIFT              &sk LA(LC(LG(LEFT_SHIFT)))                  &trans            &kp NUMBER_4       &kp N5        &kp NUMBER_6  &trans
&kp CAPSLOCK                     &trans             &trans         &sk LA(LC(LG(LEFT_SHIFT)))  &trans                                      &trans            &kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &trans
&trans                           &trans             &trans         &layer_hold_priority 3 N0   &trans                      &trans  &trans  &trans            &trans             &trans        &trans        &trans
                                 &trans             &trans         &trans                      &trans                      &trans  &trans  &trans            &trans             &trans        &trans
&trans                           &trans             &trans                                                                                                                      &trans        &trans        &trans
&kp LC(LG(LEFT))                 &kp LC(LG(RIGHT))  &trans         &trans                      &trans                                      &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans        &trans        &trans
            >;
        };

        extras {
            display-name = "extras";
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5                        &kp F6    &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP   &kp END       &trans
&kp CAPSLOCK  &trans        &trans        &trans        &trans                        &trans    &kp F11        &kp F12       &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans    &trans         &trans        &trans        &trans
              &trans        &trans        &trans        &trans        &trans  &trans  &trans    &trans         &trans        &trans
&trans        &trans        &trans                                                                             &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                        &trans    &trans         &trans        &trans        &trans
            >;
        };

        bluetooth {
            bindings = <
&bt BT_CLR    &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &bt BT_CLR_ALL
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans
&trans        &trans        &bt BT_PRV    &bt BT_NXT    &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans
              &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans                                                                    &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };

    /* 加速度 */
    pointer_accel: pointer_accel {
        compatible = "zmk,input-processor-pointing-acceleration";
        #input-processor-cells = <0>;

        input-type = <INPUT_EV_REL>;
        track-remainders;
        min-factor = <800>;
        max-factor = <3000>;
        speed-threshold = <1200>;
        speed-max = <6000>;
        acceleration-exponent = <2>;
    };
};
